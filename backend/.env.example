# === CLOUD ENVIRONMENT ===
CLOUD_ENV=cloud
CLOUD_PROVIDER=aws
DEFAULT_AWS_REGION=us-east-1

# === LM STUDIO ===
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=local-model
LM_STUDIO_TEMPERATURE=0.2
LM_STUDIO_MAX_TOKENS=8192
# LM Studio Context Length (set in LM Studio, e.g. `lms load <model> --context-length 32768`)
# must be >= prompt (~8K tokens) + LM_STUDIO_MAX_TOKENS.
LM_STUDIO_TIMEOUT=180
LLM_CHAT_MAX_TOKENS=4096
LLM_ARCHITECT_MAX_TOKENS=2048
LLM_GROQ_RETRY_MAX_TOKENS=4096
REQUIREMENTS_MAX_CHARS=12000

# === DATABASE ===
DATABASE_URL=sqlite:///./vellum.db

# === REDIS ===
REDIS_URL=redis://localhost:6379/0

# === HUMAN IN THE LOOP ===
HUMAN_APPROVAL_REQUIRED=true
AUTO_EXECUTE_READ_ONLY=true

# === TERRAFORM ===
TERRAFORM_WORKSPACE=./terraform-workspace
TERRAFORM_BINARY=terraform
